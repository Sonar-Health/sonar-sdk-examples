# A sandbox API key from Atlas (Developers). It stays on this server.
SONAR_API_KEY=
# The SDK app ID from Atlas → Developers → Apps, for your bundle ID or package name.
SONAR_APP_ID=
# The Sonar user this demo signs in as (POST /v1/users once, then reuse its id).
SONAR_USER_ID=

# Optional. A random code is printed at start when unset.
DEMO_ACCESS_CODE=
PORT=8199
